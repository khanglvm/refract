{
  "name": "brivo",
  "version": "1.0.0",
  "description": "Scoped React state with selectors and rollback. Each Provider owns a typed store; components subscribe through selectors, update with Immer drafts, and can undo any update. Works with React 18/19 and Next.js App Router.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "llms.txt",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run test && npm run clean && npm run build && npm run test:package",
    "test": "node --expose-gc --import tsx --test tests/*.test.tsx",
    "test:package": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --jsx react-jsx --target ES2020 tests/package-smoke.tsx && node --import tsx tests/package-smoke.tsx && node tests/server-smoke.mjs",
    "docs:check": "node scripts/docs-readme.mjs --check"
  },
  "keywords": [
    "react",
    "state",
    "state-management",
    "context",
    "selectors",
    "immer",
    "rollback",
    "undo",
    "optimistic-update",
    "nextjs",
    "app-router",
    "typescript"
  ],
  "author": "Khang Le",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "immer": "^10.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khanglvm/brivo.git"
  },
  "homepage": "https://brivo.khangle.dev",
  "bugs": {
    "url": "https://github.com/khanglvm/brivo/issues"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^26.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.0.0"
  },
  "packageManager": "npm@11.19.0"
}

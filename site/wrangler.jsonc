// Serves the built landing page (site/dist) as a Cloudflare Worker with static assets.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "refract-site",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "refract.khangle.dev", "custom_domain": true }]
}
